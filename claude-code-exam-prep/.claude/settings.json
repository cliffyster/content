{
  "permissions": {
    "allow": [
      "Bash(python3 -m quiz *)",
      "Bash(python3 -m unittest *)",
      "Read(./notes/**)",
      "Read(./quiz/**)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Edit(./.quiz-progress.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/study-status.sh",
            "args": [],
            "timeout": 15,
            "statusMessage": "Checking study progress..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-bank.sh",
            "args": [],
            "timeout": 30,
            "statusMessage": "Validating question bank..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-destructive.sh",
            "args": [],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
